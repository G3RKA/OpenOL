 "layout_doc": {
  "magic": "u32 0x5846504F ('OFPX' little endian) set by the first hook that runs; 0 means no hook has run yet",
  "version": "u32, 5 for this layout",
  "disable": "u32 bit mask, a SET bit switches a feature off at run time; bit 0 = one-owner enemy rule, bit 1 = command mailbox, bit 2 = shared checkpoint loads, bit 3 = enemy animations",
  "cnt_apply_calls": "u32 calls of the ApplySpawn hook",
  "cnt_send_calls": "u32 calls of the SendSpawn hook",
  "cnt_own_destroyed": "u32 times our own enemy was destroyed as a duplicate",
  "cnt_puppet_destroyed": "u32 times a puppet was destroyed as a duplicate",
  "cmd_seq": "u32 command mailbox, test -> game: the test writes cmd, cmd_arg_len and cmd_arg first and cmd_seq LAST (res_seq + 1); the per-frame hook runs the command when cmd_seq != res_seq",
  "cmd": "u32 1 = LOAD_CHECKPOINT (cmd_arg = name NUL persistent-level-name NUL, ASCII, each at most 127 bytes; the persistent name may be empty)",
  "cmd_arg_len": "u32 bytes of cmd_arg in use",
  "res_seq": "u32 game -> test: set to cmd_seq when the command has been handled",
  "res_code": "i32 0 = started, 2 = unknown command, 3 = bad argument",
  "cmd_arg": "256 bytes",
  "follow_pending": "u32 set by the receive hook when a partner's WORLD_CHECKPOINT_LOAD (0x11) arrived; the per-frame hook loads follow_name and clears it",
  "cnt_follow_sent": "u32 checkpoint loads told to the partners",
  "cnt_follow_recv": "u32 checkpoint packets received",
  "cnt_follow_exec": "u32 partner loads executed here",
  "cnt_echo_suppressed": "u32 loads not re-sent because they were a partner's load",
  "cnt_rebroadcast": "u32 times our enemies were announced again because a partner had a copy of one of them (the partner may have loaded after our first announcement)",
  "spawn_table": "64 entries of 24 bytes {u64 actor, f32 x, y, z, u32 class low bits}: where each own enemy and each puppet was first seen; the one-owner rule compares these places, so a copy that walked away after it appeared is still recognised. Cleared on every checkpoint load",
  "rebroadcast_ctrl": "u64 the multiplayer controller whose 'already announced' list the per-frame hook clears (0 = nothing to do)",
  "cnt_anim_sent": "u32 enemy animations announced to the partners (bit 3 of disable switches the feature off)",
  "cnt_anim_recv": "u32 enemy-animation packets (WORLD type 0x12) received",
  "cnt_anim_played": "u32 animations started on a puppet through the script function PlayFullBodyAnim",
  "cnt_anim_dropped": "u32 received animations not played (no such puppet, dead, no animation slot, function not found)",
  "anim_wr": "u32 write index of anim_ring (taken modulo 4)",
  "last_ctrl": "u64 the multiplayer controller seen by the enemy hooks; the per-frame hook plays queued animations only when it runs for this controller",
  "anim_ring": "4 entries of 0xB0 bytes: u32 valid (written last), i32 sender, u32 flags (bit 0 = loop), u32 rate, blendIn, blendOut, start, end (raw float bits), char enemy[64] at +0x30, char anim[64] at +0x70",
  "anim_state": "32 entries of 16 bytes {u64 enemy actor, u32 FName index, u32 FName number, u32 calls since the last announcement}: the animation already announced for an own enemy; cleared when its animation ends",
  "follow_name": "char[128]",
  "follow_persist": "char[128]",
  "expect_name": "char[128] the partner's load being executed here (echo guard)",
  "persist_table": "pairs 'checkpoint-name prefix NUL persistent level NUL', ends with an empty prefix; written into the file by the applier (data_init)"
 },
