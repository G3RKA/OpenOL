+double g_trigger_radius = 0.0;
+
+/* Hero position from the last HERO_STATE snapshot. The snapshot is the raw client packet
+ * [channel][type][player_id LE4][x f32][y f32][z f32]...; floats are little endian like the host. */
+static int player_pos(const Player *p, float out[3]) {
+    if (p->state_snap_len < 18) return 0;
+    memcpy(out, p->state_snap + 6, 12);
+    for (int i = 0; i < 3; i++)
+        if (!(out[i] > -1e7f && out[i] < 1e7f)) return 0;   /* NaN or absurd */
+    return 1;
+}
+
+void server_relay_near(Server *s, Player *sender, const char *payload, int len, double radius) {
+    int room_idx = sender->room_idx;
+    float sp[3];
+    int have_sender = player_pos(sender, sp);
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        Player *p = &s->players[i];
+        if (!p->used || p == sender || p->room_idx != room_idx) continue;
+        float rp[3];
+        if (have_sender && player_pos(p, rp)) {
+            double dx = (double)sp[0] - rp[0], dy = (double)sp[1] - rp[1], dz = (double)sp[2] - rp[2];
+            if (dx * dx + dy * dy + dz * dz > radius * radius) continue;
+        }
+        server_send(s, &p->addr, payload, len);
+    }
+}
